{
  "_readme": "Exact-match allow rules for headless Antigravity CLI (agy) workers. Merge the groups you want into userSettings.globalPermissionGrants.allow in your agy config (Windows: %USERPROFILE%\\.gemini\\config\\config.json). Matching is exact: no wildcards, so extra flags or file arguments are denied. These rules are global to every agy session and the desktop app. Back up the file first. Install/network commands are deliberately absent.",
  "git-readonly": [
    "command(git status)",
    "command(git status --short)",
    "command(git diff)",
    "command(git diff --stat)",
    "command(git log -n 2 --oneline)"
  ],
  "python-venv-windows": [
    "command(.venv\\Scripts\\python.exe -m pytest)",
    "command(.venv\\Scripts\\python.exe -m pytest -q)",
    "command(.venv\\Scripts\\python.exe -m pytest -v)",
    "command(.venv\\Scripts\\python.exe -m pytest -x -q)",
    "command(.venv\\Scripts\\python.exe manage.py check)",
    "command(.venv\\Scripts\\python.exe manage.py makemigrations --check --dry-run)"
  ],
  "python-venv-unix": [
    "command(.venv/bin/python -m pytest)",
    "command(.venv/bin/python -m pytest -q)",
    "command(.venv/bin/python -m pytest -x -q)"
  ],
  "python-no-venv": [
    "command(python -m pytest)",
    "command(python -m pytest -q)",
    "command(python -m pytest -x -q)",
    "command(py -m pytest)",
    "command(py -m pytest -q)",
    "command(py -m pytest -x -q)",
    "command(pytest)",
    "command(pytest -q)",
    "command(pytest -x -q)",
    "command(python manage.py check)",
    "command(python manage.py makemigrations --check --dry-run)"
  ],
  "rust": [
    "command(cargo check)",
    "command(cargo build)",
    "command(cargo test)",
    "command(cargo test -q)",
    "command(cargo clippy)",
    "command(cargo clippy --all-targets -- -D warnings)",
    "command(cargo fmt --check)"
  ],
  "node": [
    "command(npm test)",
    "command(npm run test)",
    "command(npm run lint)",
    "command(npm run build)",
    "command(npm run typecheck)",
    "command(npx tsc --noEmit)",
    "command(pnpm test)",
    "command(pnpm lint)",
    "command(pnpm build)",
    "command(yarn test)",
    "command(yarn lint)",
    "command(yarn build)"
  ],
  "r": [
    "command(Rscript -e \"devtools::test()\")",
    "command(Rscript -e \"testthat::test_local()\")",
    "command(Rscript -e \"devtools::check()\")",
    "command(Rscript -e \"devtools::document()\")"
  ]
}
